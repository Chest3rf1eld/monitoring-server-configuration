auth_enabled: false

server:
  http_listen_address: {{ loki_listen_address.split(':')[0] }}
  http_listen_port: {{ loki_listen_address.split(':')[1] | int }}

common:
  path_prefix: {{ loki_data_dir }}
  storage:
    filesystem:
      chunks_directory: {{ loki_data_dir }}/chunks
      rules_directory: {{ loki_data_dir }}/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2024-01-01
      store: boltdb-shipper
      object_store: filesystem
      schema: v12
      index:
        prefix: index_
        period: 24h

storage_config:
  boltdb_shipper:
    active_index_directory: {{ loki_data_dir }}/index
    cache_location: {{ loki_data_dir }}/cache
    shared_store: filesystem
  filesystem:
    directory: {{ loki_data_dir }}/chunks
