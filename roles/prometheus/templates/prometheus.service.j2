[Unit]
Description=Prometheus
Wants=network-online.target
After=network-online.target

[Service]
User={{ prometheus_user }}
Group={{ prometheus_group }}
Type=simple
ExecStart={{ prometheus_install_dir }}/prometheus --config.file={{ prometheus_config_dir }}/prometheus.yml --storage.tsdb.path={{ prometheus_data_dir }} --web.listen-address={{ prometheus_web_listen_address }}{% if prometheus_enable_web_config %} --web.config.file={{ prometheus_web_config_file }}{% endif %}

Restart=on-failure

[Install]
WantedBy=multi-user.target
